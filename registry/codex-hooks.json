{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "__REPO__/hooks/session-start.sh",
          "timeout": 30,
          "statusMessage": "Reading the repository category and open items"
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "__REPO__/hooks/prompt-nudge.sh",
          "timeout": 10,
          "statusMessage": "Checking what needs saying first"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "__REPO__/hooks/guard-shell-edit.sh",
          "timeout": 10,
          "statusMessage": "Checking how the file is being edited"
        },
        {
          "type": "command",
          "command": "__REPO__/hooks/guard-destructive.sh",
          "timeout": 10,
          "statusMessage": "Checking for irreversible commands"
        }
      ]
    },
    {
      "matcher": "apply_patch|Edit|Write",
      "hooks": [
        {
          "type": "command",
          "command": "__REPO__/hooks/guard-write-scope.sh",
          "timeout": 10,
          "statusMessage": "Checking where this writes"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "__REPO__/hooks/note-gates.sh",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "apply_patch|Edit|Write",
      "hooks": [
        {
          "type": "command",
          "command": "__REPO__/hooks/prose-check.sh",
          "timeout": 15
        }
      ]
    }
  ],
  "PreCompact": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "__REPO__/hooks/pre-compact.sh",
          "timeout": 10,
          "statusMessage": "Checking what would be lost in the summary"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "__REPO__/hooks/stop-gates.sh",
          "timeout": 15
        }
      ]
    }
  ]
}
